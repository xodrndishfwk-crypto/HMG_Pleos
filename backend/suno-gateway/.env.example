# Local deterministic demo. This provider never calls Suno and never spends credits.
MUSIC_PROVIDER=mock
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Optional local gateway authentication. Supply the same value at runtime to the app;
# never put the real value in Git, resources, BuildConfig, or screenshots.
GATEWAY_SHARED_TOKEN=

# Official Suno Platform REST access is account-gated. Do not guess these values.
# Complete the provider adapter only from the authenticated official account documentation.
SUNO_PLATFORM_ACCOUNT_ENABLED=false
